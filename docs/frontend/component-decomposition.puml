@startuml
!pragma layout smetana
skinparam shadowing false
skinparam nodesep 40
skinparam ranksep 50
skinparam defaultTextAlignment center

skinparam rectangle {
  BackgroundColor #FAFAFA
  BorderColor #BDBDBD
}
skinparam component {
  BackgroundColor #E8F0FE
  BorderColor #5C6BC0
}

title Frontend Component Decomposition — web-client/src/
top to bottom direction

component "main.tsx\n(RouterProvider)" as ENTRY

rectangle "Route Layouts" as LAYOUTS {
  component "_authenticated.tsx\n(Auth Guard)" as AUTH_LAYOUT
  component "_unauthenticated.tsx" as UNAUTH_LAYOUT
}

rectangle "App Shell" as SHELL_GROUP {
  component "AppShell\n(components/layout/)" as SHELL
  component "Sidebar" as SIDEBAR
}

rectangle "Pages" as PAGES {
  component "Dashboard" as DASH
  component "Notes\n(list + editor)" as NOTES
  component "Calendar" as CAL
  component "Chat" as CHAT
  component "Login" as LOGIN
  component "Register" as REGISTER
}

rectangle "Shared Components" as SHARED {
  component "ErrorBoundary" as ERR
  component "EmptyState" as EMPTY
  component "Skeleton" as SKELETON
  component "LoadingSpinner" as SPINNER
  component "Toast\n(sonner)" as TOAST
}

ENTRY -down-> AUTH_LAYOUT : renders
ENTRY -down-> UNAUTH_LAYOUT : renders

AUTH_LAYOUT -down-> SHELL : renders

UNAUTH_LAYOUT -down-> LOGIN : renders
UNAUTH_LAYOUT -down-> REGISTER : renders

SHELL  -down-> SIDEBAR
SHELL  -down-> DASH
SHELL  -down-> NOTES
SHELL  -down-> CAL
SHELL  -down-> CHAT

DASH   ..> EMPTY
DASH   ..> SKELETON
NOTES  ..> EMPTY
CAL    ..> SKELETON
CHAT   ..> SKELETON

SHELL  ..> ERR
SHELL  ..> TOAST
SHELL  ..> SKELETON
SHELL  ..> SPINNER

legend bottom
  Solid arrows (↓) = rendered in the layout tree.
  Dashed arrows (..>) = contextual / per-page usage.
  _authenticated guards routes — requires JWT, redirects to /login if missing.
  _unauthenticated redirects authenticated users away from login/register.
endlegend

@enduml
