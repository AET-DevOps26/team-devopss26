@startuml
!pragma layout smetana
skinparam shadowing false
skinparam nodesep 40
skinparam ranksep 60
skinparam defaultTextAlignment center

skinparam rectangle {
  BackgroundColor #FAFAFA
  BorderColor #BDBDBD
}
skinparam component {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}
skinparam database {
  BackgroundColor #F9E79F
  BorderColor #D4AC0D
}
skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #9E9E9E
}

title Frontend Architecture — React Client (web-client/)
top to bottom direction

rectangle "Web Client" #F8F9FA {
  rectangle "Build Tooling" as BUILD {
    component "Vite" as VITE
    component "Tailwind CSS v4" as TW
    component "TanStack Router" as ROUTER
  }

  rectangle "UI Layer" as UI {
    component "React 19 + shadcn/ui" as REACT
    component "AppShell + Pages\n(_authenticated routes)" as PAGES
    component "Login / Register\n(_unauthenticated routes)" as AUTH_PAGES
  }

  rectangle "State Management" as STATE {
    component "authStore (Zustand)" as AUTHSTORE
  }

  rectangle "API Layer" as API {
    component "Axios Client" as AXIOS
    component "Service Modules" as SVCS
    component "OpenAPI Types" as TYPES
  }

  rectangle "Testing" as TESTING {
    component "Vitest + RTL" as VITEST
    component "MSW" as MSW
  }
}

rectangle "External Infrastructure" #FFF3E0 {
  rectangle "Caddy Reverse Proxy" as PROXY_NODE {
    component "API Gateway" as PROXY
  }
  rectangle "Backend Services" {
    component "User Service" as BACKEND_USER #C5E1A5
    component "Note/Cal/Checklist Services" as BACKEND_CORE #C5E1A5
    component "GenAI Service" as GENAI #E1BEE7
  }
}

VITE     -down-> REACT : bundles
TW       -down-> REACT
ROUTER   -down-> PAGES : routes
ROUTER   -down-> AUTH_PAGES : routes

PAGES    -left-> REACT
PAGES    -down-> AUTHSTORE

AUTH_PAGES -down-> AUTHSTORE

SVCS     -down-> AXIOS
AXIOS    -right-> AUTHSTORE : JWT
AXIOS    -down-> PROXY : REST

PROXY    -down-> BACKEND_USER : /api/v1/users*
PROXY    -down-> BACKEND_CORE : /api/v1/notes*, /api/v1/events*, etc.
PROXY    -down-> GENAI : /api/v1/chat*, /api/v1/conversations*

VITEST   -down-> MSW
MSW      -down-> AXIOS : intercepts

legend bottom
  Auth is handled client-side via custom Login/Register routes.
  authStore (Zustand) manages the local JWT token and User ID.
  API requests are routed via Caddy Reverse Proxy to the backend services.
  MSW intercepts Axios calls during tests.
endlegend

@enduml
