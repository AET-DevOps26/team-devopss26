@startuml
!pragma layout smetana
skinparam shadowing false
skinparam nodesep 30
skinparam ranksep 40

skinparam backgroundColor #FFFFFF
skinparam defaultTextAlignment left

skinparam classBackgroundColor #F5F5F5
skinparam classBorderColor #BDBDBD
skinparam interfaceBackgroundColor #E3F2FD
skinparam interfaceBorderColor #1565C0
skinparam packageBackgroundColor #FAFAFA
skinparam packageBorderColor #E0E0E0
skinparam arrowColor #616161

title Frontend State Model — Stores, Query Hooks & Data Types

rectangle "Zustand Stores (client/session state)" as STORES {
  interface "authStore" {
    token : string | null
    userId : number | null
    username : string | null
    isAuthenticated : boolean
    --
    setAuth(token) : void
    clearAuth() : void
    validateToken() : Promise
  }

  interface "chatStore" {
    messages : Message[]
    isLoading : boolean
    sessionId : string | null
    --
    sendMessage(content)
    retryLastMessage()
  }
}

rectangle "TanStack Query (server state cache)" as TQ {
  interface "useNotes / useNote" {
    returns Note[]
  }
  interface "useCreateNote / useUpdateNote / useDeleteNote" {
    mutate(dto) → invalidates notes cache
  }
  interface "useEvents / useCreateEvent / useUpdateEvent / useDeleteEvent" {
    mutate(dto) → invalidates events cache
  }
}

rectangle "Data Types" as TYPES {
  interface "User" {
    id : number
    username : string
  }

  interface "Note" {
    id : string
    title : string
    body : string (Markdown)
    isChecklist : boolean
    checklistItems : ChecklistItem[]
  }

  interface "Event" {
    id : string
    title : string
    start : string (ISO 8601)
    end : string (ISO 8601)
    allDay : boolean
  }

  interface "Message" {
    id : string
    role : "user" | "assistant"
    content : string
  }
}

"authStore" "1" o-- "0..1" "User"
"chatStore" "1" o-- "0..*" "Message"
"useNotes / useNote" ..> "Note"
"useCreateNote / useUpdateNote / useDeleteNote" ..> "Note"
"useEvents / useCreateEvent / useUpdateEvent / useDeleteEvent" ..> "Event"

legend bottom
  Zustand stores: client-side session state, persisted to localStorage
  TanStack Query hooks: server state cache, auto-invalidated on mutation
  Data types from openapi-typescript generated code
  Auth token obtained from backend login (User Service)
endlegend

@enduml
