@startuml
!pragma layout smetana
skinparam shadowing false
skinparam nodesep 30
skinparam ranksep 40

skinparam backgroundColor #FFFFFF
skinparam defaultTextAlignment left

skinparam classBackgroundColor #F5F5F5
skinparam classBorderColor #BDBDBD
skinparam interfaceBackgroundColor #E3F2FD
skinparam interfaceBorderColor #1565C0
skinparam packageBackgroundColor #FAFAFA
skinparam packageBorderColor #E0E0E0
skinparam arrowColor #616161

title Frontend State Model — Zustand Stores & Data Types

rectangle "Zustand Stores (client/session state)" as STORES {
  interface "authStore" {
    token : string | null
    userId : number | null
    username : string | null
    isAuthenticated : boolean
    --
    setAuth(token) : void
    clearAuth() : void
    validateToken() : Promise
  }
}

rectangle "Data Types" as TYPES {
  interface "User" {
    id : number
    username : string
  }

  interface "Note" {
    id : number
    title : string
    content : string
    createdAt : string
    lastUpdatedAt : string
  }

  interface "CalendarEvent" {
    id : number
    title : string
    description : string
    startTime : string (ISO 8601)
    endTime : string (ISO 8601)
    location : string
  }

  interface "ChatMessage" {
    id : number
    role : "USER" | "AGENT"
    content : string
    timestamp : number
  }

  interface "Checklist" {
    id : number
    userId : number
    title : string
    createdAt : string
    items : ChecklistItem[]
  }

  interface "ChecklistItem" {
    id : number
    text : string
    completed : boolean
    position : number
  }
}

"authStore" "1" o-- "0..1" "User"

legend bottom
  Zustand stores: client-side session state, persisted to localStorage
  Data types from openapi-typescript generated code
  Auth token obtained from backend login (User Service)
endlegend

@enduml
