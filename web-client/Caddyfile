:80 {
    # ── Prod routes ──
    handle /api/v1/chat {
        reverse_proxy http://genai-service-app:8006
    }
    handle /api/v1/chat/* {
        reverse_proxy http://genai-service-app:8006
    }
    handle /api/v1/checklists {
        reverse_proxy http://checklist-service-app:8003
    }
    handle /api/v1/checklists/* {
        reverse_proxy http://checklist-service-app:8003
    }
    handle /api/v1/conversations {
        reverse_proxy http://genai-service-app:8006
    }
    handle /api/v1/conversations/* {
        reverse_proxy http://genai-service-app:8006
    }
    handle /api/v1/events {
        reverse_proxy http://calendar-service-app:8004
    }
    handle /api/v1/events/* {
        reverse_proxy http://calendar-service-app:8004
    }
    handle /api/v1/health {
        reverse_proxy http://genai-service-app:8006
    }
    handle /api/v1/health/* {
        reverse_proxy http://genai-service-app:8006
    }
    handle /api/v1/notes {
        reverse_proxy http://note-service-app:8005
    }
    handle /api/v1/notes/* {
        reverse_proxy http://note-service-app:8005
    }
    handle /api/v1/users/* {
        reverse_proxy http://user-service-app:8001
    }

    # Serve swagger documentation directly
    handle /swagger* {
        root * /usr/share/caddy
        file_server
    }

    # ── Monitoring routes (cross-namespace to monitoring) ──
    # Grafana: configured with GF_SERVER_SERVE_FROM_SUB_PATH=true
    # Redirect /grafana (no trailing slash) → /grafana/ so Grafana's sub-path works
    @grafana-root path /grafana
    redir @grafana-root /grafana/ 308
    # Forward /grafana/* and /grafana/ to Grafana
    @grafana path /grafana/ /grafana/*
    handle @grafana {
        reverse_proxy {$GRAFANA_UPSTREAM}
    }

    # Prometheus: configured with --web.external-url=/prometheus/ and --web.route-prefix=/
    # Redirect bare /prometheus to /prometheus/ so Prometheus' sub-path routing works
    @prometheusRoot path /prometheus
    redir @prometheusRoot /prometheus/ 308
    # Forward /prometheus/* to Prometheus, stripping the prefix
    handle_path /prometheus/* {
        reverse_proxy {$PROMETHEUS_UPSTREAM}
    }

    handle {
        root * /usr/share/caddy
        try_files {path} /index.html
        file_server
    }
}
