:80 {
    # ── Prod routes ──
    handle /api/v1/chat {
        reverse_proxy http://genai-service:8006
    }
    handle /api/v1/chat/* {
        reverse_proxy http://genai-service:8006
    }
    handle /api/v1/checklists {
        reverse_proxy http://checklist-service:8003
    }
    handle /api/v1/checklists/* {
        reverse_proxy http://checklist-service:8003
    }
    handle /api/v1/conversations {
        reverse_proxy http://genai-service:8006
    }
    handle /api/v1/conversations/* {
        reverse_proxy http://genai-service:8006
    }
    handle /api/v1/events {
        reverse_proxy http://calendar-service:8004
    }
    handle /api/v1/events/* {
        reverse_proxy http://calendar-service:8004
    }
    handle /api/v1/health {
        reverse_proxy http://genai-service:8006
    }
    handle /api/v1/health/* {
        reverse_proxy http://genai-service:8006
    }
    handle /api/v1/notes {
        reverse_proxy http://note-service:8005
    }
    handle /api/v1/notes/* {
        reverse_proxy http://note-service:8005
    }
    handle /api/v1/users/* {
        reverse_proxy http://user-service:8001
    }

    # Monitoring: expose Grafana under /grafana (Grafana serves from this
    # sub-path itself via GF_SERVER_SERVE_FROM_SUB_PATH, so don't strip the prefix).
    # Match both the bare path and everything under it so /grafana (no trailing
    # slash) hits Grafana and gets redirected, rather than falling through to the SPA.
    @grafana path /grafana /grafana/*
    handle @grafana {
        reverse_proxy http://grafana:3000
    }

    # Serve swagger documentation directly
    handle /swagger* {
        root * /usr/share/caddy
        file_server
    }

    # ── Monitoring routes (cross-namespace to monitoring) ──
    # Grafana: configured with GF_SERVER_SERVE_FROM_SUB_PATH=true
    # Forward the /grafana prefix as-is; do NOT strip it
    @grafana path /grafana /grafana/*
    handle @grafana {
        reverse_proxy http://grafana.team-devopss26-monitoring.svc.cluster.local:3000
    }

    # Prometheus: configured with --web.external-url=/prometheus/ and --web.route-prefix=/
    # Strip the prefix; Prometheus serves at / internally and generates /prometheus URLs
    @prometheus path /prometheus /prometheus/*
    handle @prometheus {
        uri strip_prefix /prometheus
        reverse_proxy http://prometheus.team-devopss26-monitoring.svc.cluster.local:9090
    }

    handle {
        root * /usr/share/caddy
        try_files {path} /index.html
        file_server
    }
}
