# ============== IntelliJ IDEA =================
# Ignoriere den Inhalt des .idea-Ordners, aber nicht den Ordner selbst.
.idea/*

# Behalte aber diese spezifischen Dateien und Ordner
!.idea/misc.xml
!.idea/vcs.xml
!.idea/codeStyles/
!.idea/runConfigurations/
!.idea/dictionaries/

# Ignoriere explizit die benutzerspezifische workspace.xml
.idea/workspace.xml

# Die .iml-Dateien werden oft durch Gradle/Maven generiert.
*.iml
*.iws
*.ipr

# ============== VS Code =================
.vscode/

# ============== OpenCode Agents =================
.agents/
.opencode/
openspec/

# ============== Maven / General =================
target/
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ============== Secrets =================
**/.env
infra/iac/azure/hosts.ini

# ============== Terraform =================
# Ignore local tfvars files (they often contain secrets/passwords)
**/*.tfvars
**/*.auto.tfvars

# Local Terraform working directories
**/.terraform/

# State Files (CRITICAL: THESE CONTAIN SECRETS IN PLAINTEXT!)
**/*.tfstate
**/*.tfstate.*

# Provider Lock File (ignored for easier local cross-platform development)
**/.terraform.lock.hcl

# Crash Logs
**/crash.log
**/crash.*.log
# ============== Security / Secrets =================
.env
*.tgz
*secret*
*credential*
*.key
*.pem
*.cert
kubeconfig
stud.yaml

# ============== OpenAPI Generated Files =================
# Ignore generated code in backend services
services/*/generated/

# Ignore OpenAPI generator cache and CLI metadata
.openapi-generator/
.openapi-generator-cli/
**/generated/.openapi-generator/
**/generated/.openapi-generator-ignore

# Ignore generated TypeScript models in web-client
web-client/src/*-service.ts
web-client/src/openapi.ts
web-client/src/api.ts

# ============== Postman =================
# Ignore local Postman environments and globals (which may contain sensitive secrets)
*.postman_environment.json
*.postman_globals.json

# Ignore local Postman working directories, backups and logs
.postman/
postman/

