# Only contains the local development variables and secrets
# Deployed secrets will be handled via GitHub secrets or some other kind of secret store

CLIENT_PORT=80
COMPOSE_PROJECT_NAME=devopss26

SERVICES_POSTGRES_URL=services-db
SERVICES_POSTGRES_PORT_INT=5432
SERVICES_POSTGRES_PORT_EXT=5432
SERVICES_POSTGRES_USER=admin
SERVICES_POSTGRES_PASSWORD=admin
SERVICES_POSTGRES_DB=genai_service_db

USER_SERVICE_APP_PORT=8001

CHECKLIST_SERVICE_APP_PORT=8003

CALENDAR_SERVICE_APP_PORT=8004

NOTE_SERVICE_APP_PORT=8005

GENAI_SERVICE_APP_PORT=8006

GEMINI_API_KEY=""
GROQ_API_KEY=""
MISTRAL_API_KEY=""
COHERE_API_KEY=""

COMPOSE_PROFILES=local

# Local deployment defaults to the self-hosted Ollama container instead of a hosted API.
DEFAULT_LLM_MODEL=local
OLLAMA_BASE_URL=http://ollama:11434
LOCAL_LLM_MODEL=llama3.2:1b

NOTE_SERVICE_URL=http://note-service-app:8005
CALENDAR_SERVICE_URL=http://calendar-service-app:8004
CHECKLIST_SERVICE_URL=http://checklist-service-app:8003
USER_SERVICE_URL=http://user-service-app:8001

WEAVIATE_HOST=weaviate
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051

LLM_TIMEZONE=Europe/Berlin


